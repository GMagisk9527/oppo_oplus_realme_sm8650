From: GMagisk9527 <GMagisk9527@users.noreply.github.com>
Date: Sat, 25 Apr 2026 00:00:00 +0800
Subject: [PATCH] locking: skip OnePlus krn_reliab debug on mutex/rwsem/pcpu hot paths

[ Found in OnePlus 6.1.141 OKI source ]

oplus_locking.o is obj-y. mutex_lock_handler / rwsem_lock_handler /
rtmutex_* / pcp_* and locking_record_switch_in_cs are called from
uncontended lock fast paths and every context switch. Debug is off
by default, but the out-of-line call (and CFI) still happens.

include/linux/percpu-rwsem.h is on the cgroup/fs hot path and still
called android_vh_pcpu_rwsem_handler plus two _trace wrappers on
every percpu_down_read/up_read. Gate those too.

Gate those calls with a false jump label. Enabling
/proc/krn_reliab/debug_enable still works. The exported
locking_record_switch_in_cs and android_vh_pcpu_rwsem_handler stay
for vendor modules.

diff --git a/kernel/locking/krn_reliab.h b/kernel/locking/krn_reliab.h
new file mode 100644
index 0000000..1663216
--- /dev/null
+++ b/kernel/locking/krn_reliab.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * OnePlus krn_reliab lock debug is compiled into mutex/rwsem/rtmutex
+ * fast paths. Gate the out-of-line calls with a jump label so the
+ * default (debug off) case is a NOP.
+ */
+#ifndef _KRN_RELIAB_H_
+#define _KRN_RELIAB_H_
+
+#include <linux/jump_label.h>
+#include <linux/types.h>
+
+struct task_struct;
+struct mutex;
+struct rw_semaphore;
+struct rt_mutex_base;
+struct percpu_rw_semaphore;
+
+DECLARE_STATIC_KEY_FALSE(krn_reliab_key);
+
+void oplus_mutex_lock_handler(u64 lock, struct task_struct *tsk,
+			      unsigned long jiffies);
+void oplus_mutex_wait_handler(struct mutex *lock);
+void oplus_rwsem_lock_handler(u64 sem, struct task_struct *tsk,
+			      unsigned long jiffies);
+void oplus_rwsem_read_wait_handler(struct rw_semaphore *sem);
+void oplus_rtmutex_lock_handler(u64 lock, struct task_struct *tsk,
+				unsigned long jiffies);
+void oplus_rtmutex_wait_handler(struct rt_mutex_base *lock);
+void oplus_pcp_wait_handler(struct percpu_rw_semaphore *sem, bool is_reader,
+			    int phase);
+void oplus_pcpu_rwsem_handler(u64 sem, struct task_struct *tsk,
+			      unsigned long jiffies);
+
+static __always_inline void mutex_lock_handler(u64 lock, struct task_struct *tsk,
+					       unsigned long jiffies)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_mutex_lock_handler(lock, tsk, jiffies);
+}
+
+static __always_inline void mutex_wait_handler(struct mutex *lock)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_mutex_wait_handler(lock);
+}
+
+static __always_inline void rwsem_lock_handler(u64 sem, struct task_struct *tsk,
+					       unsigned long jiffies)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_rwsem_lock_handler(sem, tsk, jiffies);
+}
+
+static __always_inline void rwsem_read_wait_handler(struct rw_semaphore *sem)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_rwsem_read_wait_handler(sem);
+}
+
+static __always_inline void rtmutex_lock_handler(u64 lock, struct task_struct *tsk,
+						 unsigned long jiffies)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_rtmutex_lock_handler(lock, tsk, jiffies);
+}
+
+static __always_inline void rtmutex_wait_handler(struct rt_mutex_base *lock)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_rtmutex_wait_handler(lock);
+}
+
+static __always_inline void pcp_wait_handler(struct percpu_rw_semaphore *sem,
+					     bool is_reader, int phase)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_pcp_wait_handler(sem, is_reader, phase);
+}
+
+#ifndef OPLUS_LOCKING_IMPL
+static __always_inline void android_vh_pcpu_rwsem_handler(u64 sem,
+		struct task_struct *tsk, unsigned long jiffies)
+{
+	if (static_branch_unlikely(&krn_reliab_key))
+		oplus_pcpu_rwsem_handler(sem, tsk, jiffies);
+}
+#endif
+
+#endif /* _KRN_RELIAB_H_ */
diff --git a/include/linux/percpu-rwsem.h b/include/linux/percpu-rwsem.h
index ff06454..0b6ecab 100644
--- a/include/linux/percpu-rwsem.h
+++ b/include/linux/percpu-rwsem.h
@@ -8,8 +8,7 @@
 #include <linux/wait.h>
 #include <linux/rcu_sync.h>
 #include <linux/lockdep.h>
-
-extern void android_vh_pcpu_rwsem_handler(u64 sem, struct task_struct *tsk, unsigned long jiffies);
+#include "../../kernel/locking/krn_reliab.h"
 
 void _trace_android_vh_record_pcpu_rwsem_starttime(
 		struct task_struct *tsk, unsigned long settime);
@@ -59,7 +58,8 @@ static inline void percpu_down_read(struct percpu_rw_semaphore *sem)
 	rwsem_acquire_read(&sem->dep_map, 0, 0, _RET_IP_);
 
 	preempt_disable();
-	_trace_android_vh_record_pcpu_rwsem_time_early(jiffies, sem);
+	if (static_branch_unlikely(&krn_reliab_key))
+		_trace_android_vh_record_pcpu_rwsem_time_early(jiffies, sem);
 
 	/*
 	 * We are in an RCU-sched read-side critical section, so the writer
@@ -78,8 +78,10 @@ static inline void percpu_down_read(struct percpu_rw_semaphore *sem)
 	 * bleeding the critical section out.
 	 */
 	preempt_enable();
-	_trace_android_vh_record_pcpu_rwsem_starttime(current, jiffies);
-	android_vh_pcpu_rwsem_handler((u64)sem, current, jiffies);
+	if (static_branch_unlikely(&krn_reliab_key)) {
+		_trace_android_vh_record_pcpu_rwsem_starttime(current, jiffies);
+		android_vh_pcpu_rwsem_handler((u64)sem, current, jiffies);
+	}
 }
 
 static inline bool percpu_down_read_trylock(struct percpu_rw_semaphore *sem)
@@ -101,9 +103,11 @@ static inline bool percpu_down_read_trylock(struct percpu_rw_semaphore *sem)
 	 */
 
 	if (ret) {
-		_trace_android_vh_record_pcpu_rwsem_time_early(jiffies, sem);
-		_trace_android_vh_record_pcpu_rwsem_starttime(current, jiffies);
-		android_vh_pcpu_rwsem_handler((u64)sem, current, jiffies);
+		if (static_branch_unlikely(&krn_reliab_key)) {
+			_trace_android_vh_record_pcpu_rwsem_time_early(jiffies, sem);
+			_trace_android_vh_record_pcpu_rwsem_starttime(current, jiffies);
+			android_vh_pcpu_rwsem_handler((u64)sem, current, jiffies);
+		}
 		rwsem_acquire_read(&sem->dep_map, 0, 1, _RET_IP_);
 	}
 
@@ -134,9 +138,11 @@ static inline void percpu_up_read(struct percpu_rw_semaphore *sem)
 		this_cpu_dec(*sem->read_count);
 		rcuwait_wake_up(&sem->writer);
 	}
-	_trace_android_vh_record_pcpu_rwsem_time_early(0, sem);
-	_trace_android_vh_record_pcpu_rwsem_starttime(current, 0);
-	android_vh_pcpu_rwsem_handler((u64)sem, current, 0);
+	if (static_branch_unlikely(&krn_reliab_key)) {
+		_trace_android_vh_record_pcpu_rwsem_time_early(0, sem);
+		_trace_android_vh_record_pcpu_rwsem_starttime(current, 0);
+		android_vh_pcpu_rwsem_handler((u64)sem, current, 0);
+	}
 	preempt_enable();
 }
 
